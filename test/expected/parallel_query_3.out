-- array of percentiles / values
EXPLAIN (COSTS OFF)
WITH x AS (SELECT percentile_disc(ARRAY[0.0, 0.95, 0.99, 1.0]) WITHIN GROUP (ORDER BY v) AS p FROM test_parallel)
SELECT
  p,
  abs(a - b) / 1000 < 0.01
FROM (
  SELECT
    unnest(ARRAY[0.0, 0.95, 0.99, 1.0]) p,
    unnest((SELECT p FROM x)) AS a,
    unnest(tdigest_percentile(tdigest(v, 100), ARRAY[0.0, 0.95, 0.99, 1.0])) AS b
  FROM test_parallel) foo;
                   QUERY PLAN                   
------------------------------------------------
 Subquery Scan on foo
   CTE x
     ->  Aggregate
           ->  Gather
                 Workers Planned: 2
                 ->  Parallel Seq Scan on test_parallel test_parallel_1
   ->  Aggregate
         InitPlan 2 (returns $1)
           ->  CTE Scan on x
         ->  Gather
               Workers Planned: 2
               ->  Parallel Seq Scan on test_parallel
(12 rows)

