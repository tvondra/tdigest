-- Regression test for the receive function tdigest_recv(), which parses the
-- binary representation of a t-digest.
--
-- The input is user supplied, so it has to be validated just like the text
-- input. The queries exercise all the error checks in the receive function,
-- one by one.
--
-- Test through a binary COPY, which goes through the receive function. We
-- build the input with the send functions of the individual fields.
\set VERBOSITY terse
CREATE TABLE tdigest_dst (s tdigest);
-- a valid value, to make sure the checks don't reject correct input
COPY (SELECT int4send(1)                            -- flags
          || int8send(3::bigint)                    -- count
          || int4send(10)                           -- compression
          || int4send(2)                            -- ncentroids
          || float8send(1) || int8send(1::bigint)
          || float8send(2) || int8send(2::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
--
-- sanity checks on the header
--
-- unknown flags
COPY (SELECT int4send(8)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  invalid flags for t-digest
-- compression out of the supported range
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(9)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  compression for t-digest must be in [10, 10000]
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(10001)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  compression for t-digest must be in [10, 10000]
-- non-positive total count
COPY (SELECT int4send(1)
          || int8send(0::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  count value for the t-digest must be positive
-- non-positive number of centroids
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(0))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  number of centroids for the t-digest must be positive
-- more centroids than fit into the buffer (10 * compression)
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(101))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  number of centroids for the t-digest exceeds buffer size
--
-- sanity checks on the centroids
--
-- centroid mean that is not a valid number
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send('NaN') || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  mean value for all centroids in a t-digest must be valid
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send('Infinity') || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  mean value for all centroids in a t-digest must be valid
-- the same in a sorted digest, where the check of mean order would not notice
-- (all comparisons with NaN are false, and the infinities are in order)
COPY (SELECT int4send(3)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(3)
          || float8send(1) || int8send(1::bigint)
          || float8send('NaN') || int8send(1::bigint)
          || float8send(2) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  mean value for all centroids in a t-digest must be valid
COPY (SELECT int4send(7)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(3)
          || float8send(1) || int8send(1::bigint)
          || float8send(2) || int8send(1::bigint)
          || float8send('Infinity') || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  mean value for all centroids in a t-digest must be valid
-- non-positive centroid count
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(0::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  count value for all centroids in a t-digest must be positive
-- centroid count exceeding the total count
COPY (SELECT int4send(1)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(2::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  count value of a centroid exceeds total count
-- centroids not sorted by mean
COPY (SELECT int4send(1)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(2)
          || float8send(2) || int8send(2::bigint)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
-- centroids not sorted by mean, in the old on-disk format storing sums
-- instead of means (the sums are sorted, but the means are not)
COPY (SELECT int4send(0)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(2)
          || float8send(4) || int8send(1::bigint)
          || float8send(6) || int8send(2::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
-- centroid counts overflowing the total count
COPY (SELECT int4send(1)
          || int8send(9223372036854775807::bigint)
          || int4send(10)
          || int4send(2)
          || float8send(1) || int8send(9223372036854775807::bigint)
          || float8send(2) || int8send(9223372036854775807::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  tdigest count overflow
--
-- sanity checks on the value as a whole
--
-- centroid counts not adding up to the total count
COPY (SELECT int4send(1)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  total count does not match the data (1 != 3)
-- only the valid value should have made it into the table
SELECT s FROM tdigest_dst;
                            s                             
----------------------------------------------------------
 flags 1 count 3 compression 10 centroids 2 (1, 1) (2, 2)
 flags 1 count 3 compression 10 centroids 2 (2, 2) (1, 1)
 flags 1 count 3 compression 10 centroids 2 (4, 1) (3, 2)
(3 rows)

-- exactly as many centroids as fit into the buffer is fine
TRUNCATE tdigest_dst;
COPY (SELECT int4send(1)
          || int8send(100::bigint)
          || int4send(10)
          || int4send(100)
          || (SELECT string_agg(float8send(i) || int8send(1::bigint), ''::bytea ORDER BY i)
                FROM generate_series(1, 100) AS s(i)))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
SELECT tdigest_count(s), s::json->>'centroids' AS centroids FROM tdigest_dst;
 tdigest_count | centroids 
---------------+-----------
           100 | 100
(1 row)

--
-- checks of the SORTED (2) and COMPACTED (4) flags
--
TRUNCATE tdigest_dst;
-- the SORTED and COMPACTED flags require the STORES_MEAN (1) flag
COPY (SELECT int4send(2)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  invalid flags for t-digest
COPY (SELECT int4send(4)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  invalid flags for t-digest
COPY (SELECT int4send(6)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  invalid flags for t-digest
-- and COMPACTED requires SORTED
COPY (SELECT int4send(5)
          || int8send(1::bigint)
          || int4send(10)
          || int4send(1)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  invalid flags for t-digest
-- centroids not sorted by mean, in digests marked as sorted
COPY (SELECT int4send(3)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(2)
          || float8send(2) || int8send(2::bigint)
          || float8send(1) || int8send(1::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  centroids not properly sorted
COPY (SELECT int4send(7)
          || int8send(4::bigint)
          || int4send(10)
          || int4send(3)
          || float8send(1) || int8send(1::bigint)
          || float8send(3) || int8send(1::bigint)
          || float8send(2) || int8send(2::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  centroids not properly sorted
-- a compacted digest can't have a full buffer
COPY (SELECT int4send(7)
          || int8send(100::bigint)
          || int4send(10)
          || int4send(100)
          || (SELECT string_agg(float8send(i) || int8send(1::bigint), ''::bytea ORDER BY i)
                FROM generate_series(1, 100) AS s(i)))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
ERROR:  compacted digest has full buffer
-- valid sorted and compacted digests - centroids with the same mean may be
-- in any order (and zeros with a different sign are equal)
COPY (SELECT int4send(3)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(2)
          || float8send(1) || int8send(1::bigint)
          || float8send(2) || int8send(2::bigint)
      UNION ALL
      SELECT int4send(7)
          || int8send(7::bigint)
          || int4send(10)
          || int4send(4)
          || float8send(0) || int8send(1::bigint)
          || float8send(1) || int8send(2::bigint)
          || float8send(1) || int8send(3::bigint)
          || float8send(1) || int8send(1::bigint)
      UNION ALL
      SELECT int4send(7)
          || int8send(3::bigint)
          || int4send(10)
          || int4send(2)
          || float8send(0) || int8send(1::bigint)
          || float8send('-0') || int8send(2::bigint))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
SELECT s FROM tdigest_dst;
                                   s                                    
------------------------------------------------------------------------
 flags 3 count 3 compression 10 centroids 2 (1, 1) (2, 2)
 flags 7 count 7 compression 10 centroids 4 (0, 1) (1, 2) (1, 3) (1, 1)
 flags 7 count 3 compression 10 centroids 2 (0, 1) (-0, 2)
(3 rows)

-- a sorted digest may have a full buffer, and a compacted digest may have
-- all centroids but one
TRUNCATE tdigest_dst;
COPY (SELECT int4send(3)
          || int8send(100::bigint)
          || int4send(10)
          || int4send(100)
          || (SELECT string_agg(float8send(i) || int8send(1::bigint), ''::bytea ORDER BY i)
                FROM generate_series(1, 100) AS s(i))
      UNION ALL
      SELECT int4send(7)
          || int8send(99::bigint)
          || int4send(10)
          || int4send(99)
          || (SELECT string_agg(float8send(i) || int8send(1::bigint), ''::bytea ORDER BY i)
                FROM generate_series(1, 99) AS s(i)))
  TO '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
COPY tdigest_dst FROM '/tmp/tdigest_recv_checks.bin' WITH (FORMAT binary);
SELECT (s::double precision[])[1] AS flags, tdigest_count(s),
       s::json->>'centroids' AS centroids
  FROM tdigest_dst;
 flags | tdigest_count | centroids 
-------+---------------+-----------
     3 |           100 | 100
     7 |            99 | 99
(2 rows)

DROP TABLE tdigest_dst;
