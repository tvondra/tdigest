-- Regression test for a NULL "count" argument in tdigest_add_double_count(),
-- the transition function of the tdigest(value, count, compression)
-- aggregate.
--
-- The count argument is not required to be non-NULL, and a NULL count is
-- interpreted as a single occurrence of the value - exactly like the
-- tdigest(value, compression) variant without the count argument.
-- a NULL count has to behave like an explicit count of 1
SELECT tdigest(v, NULL::bigint, 100)::text = tdigest(v, 1::bigint, 100)::text
  FROM (VALUES (1.0), (2.0)) AS t(v);
 ?column? 
----------
 t
(1 row)

-- and like the variant with no count at all
SELECT tdigest(v, NULL::bigint, 100)::text = tdigest(v, 100)::text
  FROM (VALUES (1.0), (2.0)) AS t(v);
 ?column? 
----------
 t
(1 row)

