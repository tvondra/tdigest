-- Regression test for the NULL handling in the transition functions.
--
-- None of the three transition functions is strict, so NULL rows do reach
-- them and have to be ignored. Each is exercised twice: once with all input
-- rows NULL (so the state stays NULL and the aggregate returns NULL), and
-- once with a NULL row following a non-NULL one (so the transition function
-- returns the existing state unmodified).
--
-- The digest is deliberately not passed to any of the consuming functions -
-- what is under test is the transition function, and the consumer cannot
-- influence it. See empty_input for the consumers.
-- tdigest_add_double
SELECT tdigest(v, 100) FROM (VALUES (NULL::double precision), (NULL)) AS t(v);
 tdigest 
---------
 
(1 row)

SELECT tdigest(v, 100) FROM (VALUES (1.0), (NULL)) AS t(v);
                      tdigest                       
----------------------------------------------------
 flags 1 count 1 compression 100 centroids 1 (1, 1)
(1 row)

-- tdigest_add_double_count
SELECT tdigest(v, 1::bigint, 100) FROM (VALUES (NULL::double precision), (NULL)) AS t(v);
 tdigest 
---------
 
(1 row)

SELECT tdigest(v, 1::bigint, 100) FROM (VALUES (1.0), (NULL)) AS t(v);
                      tdigest                       
----------------------------------------------------
 flags 1 count 1 compression 100 centroids 1 (1, 1)
(1 row)

-- tdigest_add_digest
SELECT tdigest(d) FROM (VALUES (NULL::tdigest), (NULL)) AS t(d);
 tdigest 
---------
 
(1 row)

SELECT tdigest(d) FROM (VALUES ('flags 1 count 1 compression 100 centroids 1 (1, 1)'::tdigest), (NULL)) AS t(d);
                      tdigest                       
----------------------------------------------------
 flags 1 count 1 compression 100 centroids 1 (1, 1)
(1 row)

