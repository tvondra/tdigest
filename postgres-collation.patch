 /*
- * Get database default locale.
+ * Initialize default_locale with a plain C/POSIX locale, without consulting
+ * the system catalogs.
+ *
+ * A normal backend uses init_database_collation() instead, which reads the
+ * database's locale settings from pg_database.  This variant exists for
+ * standalone programs -- such as the fuzzing harnesses in src/test/fuzz --
+ * that need to run type input/output code (which may classify characters via
+ * the default collation) without access to a live catalog.
  */
+void
+init_database_collation_standalone(void)
+{
+	pg_locale_t result;
+
+	Assert(default_locale == NULL);
+
+	result = MemoryContextAllocZero(TopMemoryContext,
+									sizeof(struct pg_locale_struct));
+	result->deterministic = true;
+	result->collate_is_c = true;
+	result->ctype_is_c = true;
+	result->is_default = true;
+
+	default_locale = result;
+}
+
+
 pg_locale_t
 pg_database_locale(void)
 {
